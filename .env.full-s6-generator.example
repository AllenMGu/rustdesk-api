TZ=Asia/Shanghai
RUSTDESK_HOST=rustdesk.example.com
RUSTDESK_API_PUBLIC_URL=https://rustdesk.example.com
ENCRYPTED_ONLY=0
MUST_LOGIN=N

# Optional display URL. GitHub Actions does not connect back to this address.
RDGEN_PUBLIC_URL=http://rustdesk.internal.example:21114/rdgen
RDGEN_GITHUB_USER=AllenMGu
RDGEN_GITHUB_REPOSITORY=rdgen
RDGEN_GITHUB_BRANCH=master
RDGEN_GITHUB_TOKEN=replace-with-a-fine-grained-token
RDGEN_SECRET_KEY=replace-with-a-long-random-django-secret
RDGEN_ZIP_PASSWORD=replace-with-the-same-value-as-the-repository-secret
RDGEN_GITHUB_POLL_INTERVAL=60
# Leave empty: this deployment uses GitHub-hosted Windows runners.
RDGEN_SELF_HOST_SECRET=
# Used only inside the server when the form password is empty.
RDGEN_DEFAULT_PERMANENT_PASSWORD=
RDGEN_PORT=8000

RUSTDESK_SOURCE_REPOSITORY=AllenMGu/rustdesk
RUSTDESK_SOURCE_REF=master
