TZ=Asia/Shanghai
# Hostname or IP reachable by RustDesk clients; do not include a scheme or port.
RUSTDESK_HOST=rustdesk.example.com
# Full browser-facing API URL, including http:// or https://.
RUSTDESK_API_PUBLIC_URL=https://rustdesk.example.com
# RustDesk API Web language: zh-CN or en.
RUSTDESK_API_LANG=zh-CN
# RustDesk server transport and login policy.
ENCRYPTED_ONLY=0
MUST_LOGIN=N

# This same rustdesk-api repository contains the RDGen Actions workflows.
RDGEN_GITHUB_USER=AllenMGu
RDGEN_GITHUB_REPOSITORY=rustdesk-api
RDGEN_GITHUB_BRANCH=master
RDGEN_GITHUB_TOKEN=replace-with-a-fine-grained-token
# Generate unique values, for example: openssl rand -hex 32
RDGEN_SECRET_KEY=replace-with-a-long-random-django-secret
# Authenticates the RustDesk API reverse proxy to the internal generator.
RDGEN_INTERNAL_TOKEN=replace-with-a-second-long-random-secret
# Must exactly match the ZIP_PASSWORD Actions secret in AllenMGu/rustdesk-api.
RDGEN_ZIP_PASSWORD=replace-with-the-same-value-as-the-repository-secret
RDGEN_GITHUB_POLL_INTERVAL=60
# Mark a build as timed out after six hours.
RDGEN_GITHUB_BUILD_TIMEOUT=21600
# Internal Gunicorn process and thread counts.
RDGEN_WORKERS=2
RDGEN_THREADS=4
# Used only inside the server when the form password is empty.
RDGEN_DEFAULT_PERMANENT_PASSWORD=

# RustDesk source checkout used by every build.
RUSTDESK_SOURCE_REPOSITORY=AllenMGu/rustdesk
# A non-empty value fixes the checkout ref and overrides the version selector.
RUSTDESK_SOURCE_REF=master
