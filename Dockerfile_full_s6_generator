FROM rustdesk/rustdesk-server-s6:1.1.16 AS server

FROM --platform=$BUILDPLATFORM node:20-alpine AS web

ARG WEBCLIENT_REPOSITORY=https://github.com/lejianwen/rustdesk-api-web.git
ARG WEBCLIENT_REF=master

RUN apk add --no-cache git \
    && git init /opt/rustdesk-api-web \
    && git -C /opt/rustdesk-api-web remote add origin "${WEBCLIENT_REPOSITORY}" \
    && git -C /opt/rustdesk-api-web fetch --depth 1 origin "${WEBCLIENT_REF}" \
    && git -C /opt/rustdesk-api-web checkout --detach FETCH_HEAD

COPY docker/full-s6-generator/web-overrides/ /tmp/web-overrides/

RUN mkdir -p \
      /opt/rustdesk-api-web/src/api \
      /opt/rustdesk-api-web/src/views/rdgen \
    && cp /tmp/web-overrides/src/api/rdgen.js \
      /opt/rustdesk-api-web/src/api/rdgen.js \
    && cp /tmp/web-overrides/src/views/rdgen/index.vue \
      /opt/rustdesk-api-web/src/views/rdgen/index.vue \
    && node /tmp/web-overrides/patch-router.mjs \
      /opt/rustdesk-api-web/src/router/index.js \
    && cd /opt/rustdesk-api-web \
    && npm ci \
      --registry=https://registry.npmjs.org \
      --replace-registry-host=always \
      --no-audit \
      --no-fund \
    && npm run build

FROM python:3.13-alpine

ARG BUILDARCH

WORKDIR /app

COPY rdgen/ /opt/rdgen/

RUN apk add --no-cache --virtual .rdgen-runtime \
      libffi \
      libjpeg-turbo \
      tzdata \
      zlib \
    && apk add --no-cache --virtual .rdgen-build-deps \
      build-base \
      jpeg-dev \
      libffi-dev \
      linux-headers \
      zlib-dev \
    && python -m venv /opt/rdgen/.venv \
    && /opt/rdgen/.venv/bin/pip install --no-cache-dir \
      -r /opt/rdgen/requirements.txt \
    && apk del .rdgen-build-deps

COPY ./${BUILDARCH}/release /app/
RUN rm -rf /app/resources/admin
COPY --from=web /opt/rustdesk-api-web/dist /app/resources/admin

COPY --from=server /init /init
COPY --from=server /etc/s6-overlay /etc/s6-overlay
COPY --from=server /package /package
COPY --from=server /usr/bin/healthcheck.sh /usr/bin/healthcheck.sh
COPY --from=server /usr/bin/hbbr /usr/bin/hbbr
COPY --from=server /usr/bin/hbbs /usr/bin/hbbs
COPY --from=server /usr/bin/rustdesk-utils /usr/bin/rustdesk-utils
COPY --from=server /command /command

COPY docker/full-s6-generator/rootfs/ /

RUN addgroup -S rdgen \
    && adduser -S -D -H -h /opt/rdgen -G rdgen rdgen \
    && mkdir -p \
      /etc/s6-overlay/s6-rc.d/api \
      /opt/rdgen/data \
      /opt/rdgen/exe \
      /opt/rdgen/png \
      /opt/rdgen/temp_zips \
    && printf "key-secret\nhbbs\n" \
      > /etc/s6-overlay/s6-rc.d/api/dependencies \
    && printf "longrun\n" > /etc/s6-overlay/s6-rc.d/api/type \
    && printf '%s\n' \
      '#!/command/with-contenv sh' \
      'cd /app' \
      'exec ./apimain' \
      > /etc/s6-overlay/s6-rc.d/api/run \
    && touch /etc/s6-overlay/s6-rc.d/user/contents.d/api \
    && chmod 755 \
      /etc/s6-overlay/s6-rc.d/api/run \
      /etc/s6-overlay/s6-rc.d/rdgen/run \
      /etc/s6-overlay/s6-rc.d/rdgen-poller/run \
      /etc/s6-overlay/s6-rc.d/rdgen-prepare/run \
    && chown -R rdgen:rdgen \
      /opt/rdgen/data \
      /opt/rdgen/exe \
      /opt/rdgen/png \
      /opt/rdgen/temp_zips \
    && printf '%s\n' \
      '/package/admin/s6/command/s6-svstat /run/s6-rc/servicedirs/api || exit 1' \
      '/package/admin/s6/command/s6-svstat /run/s6-rc/servicedirs/rdgen || exit 1' \
      '/package/admin/s6/command/s6-svstat /run/s6-rc/servicedirs/rdgen-poller || exit 1' \
      >> /usr/bin/healthcheck.sh \
    && ln -s /run /var/run

ENV RELAY=relay.example.com \
    ENCRYPTED_ONLY=0 \
    PYTHONUNBUFFERED=1 \
    DATABASE_PATH=/opt/rdgen/data/db.sqlite3 \
    RDGEN_PORT=8000 \
    RDGEN_WORKERS=2 \
    RDGEN_THREADS=4 \
    GHBRANCH=master \
    REPONAME=rustdesk-api \
    PROTOCOL=https \
    RUSTDESK_REPOSITORY=rustdesk/rustdesk \
    RUSTDESK_REF= \
    RUSTDESK_PUBLIC_KEY_FILE=/opt/rdgen/data/server-public-key \
    RDGEN_INTERNAL_URL=http://127.0.0.1:8000 \
    RDGEN_CLIENT_DEFAULTS_FILE=/app/data/rdgen-client-defaults.json \
    DEFAULT_PERMANENT_PASSWORD= \
    GITHUB_POLL_INTERVAL=60 \
    GITHUB_BUILD_TIMEOUT=21600 \
    ARTIFACT_ROOT=/opt/rdgen/exe

VOLUME ["/data", "/app/data", "/opt/rdgen/data", "/opt/rdgen/exe", "/opt/rdgen/png", "/opt/rdgen/temp_zips"]

EXPOSE 8000 21114 21115 21116 21116/udp 21117 21118 21119

HEALTHCHECK --interval=30s --timeout=5s CMD /usr/bin/healthcheck.sh

ENTRYPOINT ["/init"]
